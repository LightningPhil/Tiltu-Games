    "test:ai:pawns": "node tests/ai-benchmarks/king-pawn.ts"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "rollup": "4.59.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
